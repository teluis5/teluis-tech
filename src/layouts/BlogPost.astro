---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ad from '../components/Ad.astro';
import { Icon } from 'astro-icon/components';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, categories } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				max-height: 500px;
				object-fit: cover;
			}
			.prose {
				color: var(--text-main);
				font-size: 1.05rem;
			}
			.prose h2 {
				font-size: 1.45rem;
				padding: 0.8rem 1.2rem;
				background-color: var(--bg-main);
				border-left: 6px solid var(--theme-accent);
				border-bottom: 1px solid var(--border-color);
				border-radius: 0 4px 4px 0;
				margin-top: 3.5rem;
				margin-bottom: 1.5rem;
			}
			.prose h3 {
				font-size: 1.25rem;
				padding: 0.4rem 0.8rem;
				border-left: 4px solid var(--theme-accent);
				border-bottom: 1px solid var(--border-color);
				margin-top: 2.8rem;
				margin-bottom: 1.2rem;
			}
			.prose h4 {
				font-size: 1.1rem;
				display: flex;
				align-items: center;
				padding-bottom: 0.3rem;
				border-bottom: 1px dashed var(--border-color);
				margin-top: 2.2rem;
				margin-bottom: 1rem;
			}
			.prose h4::before {
				content: "";
				display: inline-block;
				width: 8px;
				height: 8px;
				background-color: var(--theme-accent);
				border-radius: 2px;
				margin-right: 0.6rem;
				flex-shrink: 0;
			}
			.prose h5 {
				font-size: 1.0rem;
				font-weight: 700;
				color: var(--text-main);
				padding-left: 0.6rem;
				border-left: 2px solid var(--text-light);
				margin-top: 1.8rem;
				margin-bottom: 0.8rem;
			}
			.prose strong {
				font-weight: 700;
				background: linear-gradient(transparent 60%, #fff3cd 60%);
			}
			.prose table strong {
				background: none;
			}
			.prose ul, .prose ol {
				padding-left: 1.5rem;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
				line-height: 1.8;
			}
			.prose blockquote {
				background: #f0f9ff;
				border-left: 5px solid var(--theme-accent);
				padding: 1.2rem 1.5rem;
				margin: 2rem 0;
				border-radius: 4px;
				color: #075985;
				font-weight: 700;
				font-size: 1.1rem;
			}
			.prose blockquote p {
				margin: 0;
			}
			.title {
				margin-bottom: 2em;
				line-height: 1.4;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 1.8rem;
			}
			.date {
				margin-bottom: 1em;
				color: var(--text-light);
				font-size: 0.9em;
				display: flex;
				gap: 1em;
				align-items: center;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.tag {
				display: inline-block;
				background-color: #e0f2fe;
				color: #0369a1;
				padding: 0.2rem 0.6rem;
				border-radius: 9999px;
				font-size: 0.85rem;
				text-decoration: none;
				font-weight: 600;
				display: inline-flex;
				align-items: center;
				gap: 0.2rem;
			}
			.tag:hover {
				background-color: #bae6fd;
			}
			/* Sidebar Widgets */
			.widget {
				padding: 1.5rem;
				margin-bottom: 2rem;
			}
			.widget-title {
				font-size: 1.1rem;
				color: var(--text-main);
				background-color: #f7f7f7;
				padding: 0.5rem 1rem;
				border-left: 4px solid var(--theme-accent);
				margin: -1.5rem -1.5rem 1.5rem -1.5rem;
			}
			.profile-pic {
				width: 100px;
				height: 100px;
				border-radius: 50%;
				margin: 0 auto 1rem;
				background-color: var(--border-color);
				display: block;
			}
			.profile-desc {
				font-size: 0.9rem;
				color: var(--text-main);
				text-align: center;
				line-height: 1.6;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout-container">
				<!-- メインコンテンツ (左カラム) -->
				<article class="layout-main">
					<div class="title">
						<div class="date">
							<span><Icon name="heroicons:calendar" class="icon-inline" /> <FormattedDate date={pubDate} /></span>
							{
								updatedDate && (
									<span><Icon name="heroicons:arrow-path" class="icon-inline" /> <FormattedDate date={updatedDate} /></span>
								)
							}
						</div>
						<h1>{title}</h1>
						{categories && categories.length > 0 && (
							<div class="tags">
								{categories.map((category: string) => (
									<a href={`/category/${category}`} class="tag"><Icon name="heroicons:tag" class="icon-inline" /> {category}</a>
								))}
							</div>
						)}
					</div>
					
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					
					<div class="prose">
						<slot />
						
						<!-- 記事下広告 -->
						<div style="margin-top: 3rem;">
							<Ad />
						</div>
					</div>
				</article>

				<!-- サイドバー (右カラム) -->
				<aside class="layout-sidebar">
					<div class="widget box">
						<div class="widget-title"><Icon name="heroicons:user" class="icon-inline" /> プロフィール</div>
						<img class="profile-pic" src="/brand/teluis_avatar.jpg" alt="プロフィール画像" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; background-color: var(--border-color); display: block; object-fit: cover;" />
						<p class="profile-desc" style="font-size: 0.9rem; color: var(--text-main); text-align: left; line-height: 1.6;">
							<strong>ITエンジニア / コンサルタント</strong><br/>
							日経大手企業でキャリアをスタートし、AIスタートアップでの開発経験を経て、現在はコンサルティングファームに勤務。ビジネスマンに必要なスキルや、日々の業務で得た実践的なエッセンスを発信しています。
						</p>
					</div>

					<div class="widget box">
						<div class="widget-title"><Icon name="heroicons:users" class="icon-inline" /> TELUIS 妻</div>
						<img class="profile-pic" src="/brand/テルイズ妻.png" alt="妻プロフィール" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; background-color: var(--border-color); display: block; object-fit: cover;" />
						<p class="profile-desc" style="font-size: 0.9rem; color: var(--text-main); text-align: center; line-height: 1.6;">
							共同運営者。<br/>時々記事を書いたりサポートしています。
						</p>
					</div>

					<!-- サイドバー広告 -->
					<div class="widget box" style="padding: 1rem; text-align: center;">
						<div style="font-size:0.8rem; color:var(--text-light); margin-bottom:0.5rem;">スポンサーリンク</div>
						<Ad />
					</div>
				</aside>
			</div>
		</main>
		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const tables = document.querySelectorAll('.prose table');
				tables.forEach(table => {
					// 最初の行の列数をカウント（DOMの table.rows を使用して正確に取得）
					const firstRowCols = table.rows.length > 0 ? table.rows[0].cells.length : 0;
					
					// 比較対象の数（列数 - 1）
					const targetCount = firstRowCols - 1;
					
					// 比較対象が3つ以上（全体で4列以上）の場合にロジックを適用
					if (targetCount >= 3) {
						// 1番左の列（比較項目）の幅を「1文字幅＋パディング」程度に固定
						const leftColWidth = '3.5rem';
						
						const firstTh = table.querySelector('thead th:first-child');
						if (firstTh) {
							firstTh.style.width = leftColWidth;
							firstTh.style.minWidth = leftColWidth;
						}
						
						table.style.tableLayout = 'fixed';
						table.classList.add('table-fixed-left-col');
						
						if (targetCount > 3) {
							// 比較対象が4つ以上の場合は、スクロール領域を作るために表自体の幅を広げる
							// 画面に「左端の列 ＋ 比較対象3つ」がピッタリ収まる基準幅に対する倍率
							const ratio = targetCount / 3;
							table.style.width = `calc(${leftColWidth} + (100% - ${leftColWidth}) * ${ratio})`;
							
							// ラッパーを作成
							const wrapper = document.createElement('div');
							wrapper.className = 'table-scroll-wrapper';
							
							// スクロールガイドを作成
							const hint = document.createElement('div');
							hint.className = 'table-scroll-hint';
							hint.innerHTML = '<span>← 左右にスクロールできます →</span>';
							
							// DOMツリーに挿入
							table.parentNode?.insertBefore(wrapper, table);
							wrapper.appendChild(hint);
							wrapper.appendChild(table);
						} else {
							// 比較対象が3つの場合は画面幅にピッタリ収める
							table.style.width = '100%';
						}
					}
				});
			});
		</script>
	</body>
</html>

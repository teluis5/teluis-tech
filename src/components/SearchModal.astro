---
import { Icon } from 'astro-icon/components';
---

<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
	<div class="search-backdrop" id="search-backdrop"></div>
	
	<div class="search-container">
		<div class="search-box box">
			<div class="search-header">
				<Icon name="heroicons:magnifying-glass" class="search-input-icon" />
				<input
					type="search"
					id="search-input"
					class="search-input"
					placeholder="記事を検索（タイトル・キーワード・カテゴリ）..."
					autocomplete="off"
					spellcheck="false"
					aria-label="サイト内検索"
				/>
				<button type="button" id="search-close-btn" class="search-close-btn" aria-label="閉じる">
					<Icon name="heroicons:x-mark" class="icon-inline" />
				</button>
			</div>

			<div id="search-results-area" class="search-results-area">
				<div id="search-status" class="search-status">キーワードを入力して検索</div>
				<ul id="search-results-list" class="search-results-list" role="listbox"></ul>
			</div>

			<div class="search-footer">
				<div class="search-shortcuts">
					<span><kbd>↑</kbd><kbd>↓</kbd> 移動</span>
					<span><kbd>Enter</kbd> 決定</span>
					<span><kbd>Esc</kbd> 閉じる</span>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	let searchIndex = null;
	let isLoading = false;
	let selectedIndex = -1;

	const modal = document.getElementById('search-modal');
	const backdrop = document.getElementById('search-backdrop');
	const closeBtn = document.getElementById('search-close-btn');
	const input = document.getElementById('search-input');
	const statusEl = document.getElementById('search-status');
	const resultsList = document.getElementById('search-results-list');

	// インデックスデータの取得
	async function loadIndex() {
		if (searchIndex || isLoading) return;
		isLoading = true;
		if (statusEl) statusEl.textContent = '検索データを読み込み中...';
		try {
			const res = await fetch('/search-index.json');
			if (!res.ok) throw new Error('Failed to fetch search index');
			searchIndex = await res.json();
			if (statusEl) statusEl.textContent = 'キーワードを入力して検索';
		} catch (err) {
			console.error('Search index load error:', err);
			if (statusEl) statusEl.textContent = '検索データの取得に失敗しました';
		} finally {
			isLoading = false;
		}
	}

	// モーダルを開く
	function openModal() {
		if (!modal || !input) return;
		modal.classList.add('open');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		loadIndex().then(() => {
			if (input.value.trim()) {
				handleSearch();
			}
		});
		setTimeout(() => input.focus(), 50);
	}

	// モーダルを閉じる
	function closeModal() {
		if (!modal || !input) return;
		modal.classList.remove('open');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		input.value = '';
		if (resultsList) resultsList.innerHTML = '';
		if (statusEl) {
			statusEl.textContent = 'キーワードを入力して検索';
			statusEl.style.display = 'block';
		}
		selectedIndex = -1;
	}

	// テキスト内のマッチ部分をハイライト
	function highlightMatch(text, queries) {
		if (!text) return '';
		let escapedText = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		queries.forEach((q) => {
			if (!q) return;
			const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
			escapedText = escapedText.replace(regex, '<mark class="search-highlight">$1</mark>');
		});
		return escapedText;
	}

	// 検索実行ロジック
	function handleSearch() {
		if (!input || !resultsList || !statusEl) return;
		const query = input.value.trim().toLowerCase();

		if (!query) {
			resultsList.innerHTML = '';
			statusEl.textContent = 'キーワードを入力して検索';
			statusEl.style.display = 'block';
			selectedIndex = -1;
			return;
		}

		if (!searchIndex) {
			statusEl.textContent = 'データを読み込み中...';
			statusEl.style.display = 'block';
			return;
		}

		// 全角・半角スペースでAND分割
		const keywords = query.split(/[\s\u3000]+/).filter(Boolean);

		const matchedItems = [];

		searchIndex.forEach((item) => {
			const titleLower = (item.title || '').toLowerCase();
			const descLower = (item.description || '').toLowerCase();
			const catsLower = (item.categories || []).join(' ').toLowerCase();

			// 全キーワードが含まれているか判定
			const matchesAll = keywords.every((kw) =>
				titleLower.includes(kw) || descLower.includes(kw) || catsLower.includes(kw)
			);

			if (matchesAll) {
				let score = 0;
				keywords.forEach((kw) => {
					if (titleLower.includes(kw)) score += 10;
					if (catsLower.includes(kw)) score += 5;
					if (descLower.includes(kw)) score += 1;
				});
				matchedItems.push({ item, score });
			}
		});

		// スコア降順にソート
		matchedItems.sort((a, b) => b.score - a.score);

		if (matchedItems.length === 0) {
			resultsList.innerHTML = '';
			statusEl.textContent = `「${input.value.trim()}」に一致する記事は見つかりませんでした`;
			statusEl.style.display = 'block';
			selectedIndex = -1;
			return;
		}

		statusEl.style.display = 'none';
		selectedIndex = -1;

		// 結果の描画（最大20件）
		const displayItems = matchedItems.slice(0, 20);
		resultsList.innerHTML = displayItems
			.map(({ item }, index) => {
				const highlightedTitle = highlightMatch(item.title, keywords);
				const descSnippet = item.description && item.description.length > 90
					? item.description.slice(0, 90) + '...'
					: item.description || '';
				const highlightedDesc = highlightMatch(descSnippet, keywords);
				const categoryHtml = (item.categories || [])
					.map((cat) => `<span class="search-result-cat">${cat}</span>`)
					.join('');

				return `
				<li class="search-result-item" data-index="${index}">
					<a href="${item.url}" class="search-result-link">
						<div class="search-result-meta">
							${categoryHtml ? `<div class="search-result-cats">${categoryHtml}</div>` : ''}
							${item.pubDate ? `<time class="search-result-date">${item.pubDate}</time>` : ''}
						</div>
						<div class="search-result-title">${highlightedTitle}</div>
						${highlightedDesc ? `<div class="search-result-desc">${highlightedDesc}</div>` : ''}
					</a>
				</li>
				`;
			})
			.join('');
	}

	// キーボード移動の更新
	function updateSelection() {
		if (!resultsList) return;
		const items = resultsList.querySelectorAll('.search-result-item');
		items.forEach((item, idx) => {
			if (idx === selectedIndex) {
				item.classList.add('selected');
				item.scrollIntoView({ block: 'nearest' });
			} else {
				item.classList.remove('selected');
			}
		});
	}

	// イベントリスナーの登録
	function initSearch() {
		// 開くトリガー（ヘッダー等のボタンから）
		document.querySelectorAll('.search-trigger-btn').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				openModal();
			});
		});

		// 閉じる操作
		closeBtn?.addEventListener('click', closeModal);
		backdrop?.addEventListener('click', closeModal);

		// 入力ハンドラ
		input?.addEventListener('input', handleSearch);

		// キーボード操作
		window.addEventListener('keydown', (e) => {
			// Cmd+K または Ctrl+K で開閉
			if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
				e.preventDefault();
				if (modal?.classList.contains('open')) {
					closeModal();
				} else {
					openModal();
				}
				return;
			}

			// フォーカスが入力要素にない時の '/' キーで開く
			if (e.key === '/' && !modal?.classList.contains('open')) {
				const activeTag = document.activeElement?.tagName.toLowerCase();
				if (activeTag !== 'input' && activeTag !== 'textarea') {
					e.preventDefault();
					openModal();
					return;
				}
			}

			// モーダルが開いている時の操作
			if (modal?.classList.contains('open')) {
				if (e.key === 'Escape') {
					e.preventDefault();
					closeModal();
				} else if (e.key === 'ArrowDown') {
					e.preventDefault();
					const items = resultsList?.querySelectorAll('.search-result-item');
					if (items && items.length > 0) {
						selectedIndex = (selectedIndex + 1) % items.length;
						updateSelection();
					}
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					const items = resultsList?.querySelectorAll('.search-result-item');
					if (items && items.length > 0) {
						selectedIndex = (selectedIndex - 1 + items.length) % items.length;
						updateSelection();
					}
				} else if (e.key === 'Enter') {
					if (selectedIndex >= 0 && resultsList) {
						const selectedLink = resultsList.querySelector(`.search-result-item[data-index="${selectedIndex}"] a`);
						if (selectedLink) {
							e.preventDefault();
							selectedLink.click();
						}
					}
				}
			}
		});
	}

	document.addEventListener('DOMContentLoaded', initSearch);
	document.addEventListener('astro:page-load', initSearch);
</script>

<style>
	.search-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
		overflow-y: auto;
		align-items: flex-start;
		justify-content: center;
		padding: 3rem 1rem;
	}

	.search-modal.open {
		display: flex;
	}

	.search-backdrop {
		position: fixed;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		animation: fadeIn 0.2s ease-out;
	}

	.search-container {
		position: relative;
		width: 100%;
		max-width: 640px;
		z-index: 1;
		animation: slideDown 0.25s ease-out;
	}

	.search-box {
		background-color: var(--bg-content);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: 80vh;
	}

	.search-header {
		display: flex;
		align-items: center;
		padding: 0.85rem 1.2rem;
		border-bottom: 1px solid var(--border-color);
		gap: 0.75rem;
		background-color: var(--bg-content);
	}

	.search-input-icon {
		font-size: 1.3rem;
		color: var(--text-light);
		flex-shrink: 0;
	}

	.search-input {
		flex: 1;
		border: none;
		outline: none;
		background: transparent;
		font-size: 1.1rem;
		color: var(--text-main);
		font-family: inherit;
		min-width: 0;
	}

	.search-input::-webkit-search-cancel-button {
		cursor: pointer;
	}

	.search-close-btn {
		background: none;
		border: none;
		cursor: pointer;
		color: var(--text-light);
		padding: 0.3rem;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.search-close-btn:hover {
		background-color: var(--bg-main);
		color: var(--text-main);
	}

	.search-results-area {
		overflow-y: auto;
		padding: 0.5rem 0;
		flex: 1;
	}

	.search-status {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--text-light);
		font-size: 0.95rem;
	}

	.search-results-list {
		list-style: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}

	.search-result-item {
		border-bottom: 1px solid var(--border-color);
		transition: background-color 0.15s ease;
	}

	.search-result-item:last-child {
		border-bottom: none;
	}

	.search-result-item.selected,
	.search-result-item:hover {
		background-color: #f0f7fa;
	}

	.search-result-link {
		display: block;
		padding: 0.85rem 1.2rem;
		text-decoration: none !important;
		color: inherit;
	}

	.search-result-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.3rem;
		font-size: 0.8rem;
	}

	.search-result-cats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.search-result-cat {
		background-color: #e0f2fe;
		color: #0369a1;
		padding: 0.1rem 0.45rem;
		border-radius: 9999px;
		font-weight: 600;
		font-size: 0.75rem;
	}

	.search-result-date {
		color: var(--text-light);
	}

	.search-result-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.25rem;
		line-height: 1.4;
	}

	.search-result-item.selected .search-result-title,
	.search-result-item:hover .search-result-title {
		color: var(--theme-accent);
	}

	.search-result-desc {
		font-size: 0.85rem;
		color: var(--text-light);
		line-height: 1.5;
	}

	:global(.search-highlight) {
		background-color: #fef08a;
		color: inherit;
		font-weight: 700;
		padding: 0 0.15em;
		border-radius: 2px;
	}

	.search-footer {
		padding: 0.6rem 1.2rem;
		background-color: var(--bg-main);
		border-top: 1px solid var(--border-color);
		display: flex;
		justify-content: flex-end;
		font-size: 0.8rem;
		color: var(--text-light);
	}

	.search-shortcuts {
		display: flex;
		gap: 1rem;
	}

	.search-shortcuts kbd {
		background-color: var(--bg-content);
		border: 1px solid var(--border-color);
		padding: 0.1rem 0.35rem;
		border-radius: 3px;
		font-size: 0.75rem;
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
		margin-right: 0.2rem;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes slideDown {
		from {
			opacity: 0;
			transform: translateY(-12px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 640px) {
		.search-modal {
			padding: 1rem 0.5rem;
		}
		.search-shortcuts span:not(:last-child) {
			display: none;
		}
	}
</style>